# Copy to .env for local use, or paste into Streamlit Cloud > Settings > Secrets.

# --- Required for real use ---
# Any long random string. Scrambles email addresses. Never change it after launch.
APP_SECRET=
# Postgres URL (for example from Supabase). Leave empty to use a local SQLite file.
DATABASE_URL=
# Who can join (comma separated)
ALLOWED_DOMAINS=uchicago.edu
# Your own email: makes you an admin (can hide posts, ban, make organizers)
ADMIN_EMAILS=

# --- Sign-in email (Gmail app password works) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Local testing ONLY. Shows the sign-in code on screen. Keep 0 in production. ---
DEV_SHOW_CODE=0

# --- Food check ---
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
VISION_CALLS_PER_SESSION=12
FEEDBACK_WEBHOOK_URL=
