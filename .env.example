# Copy to .env for local use, or paste into Streamlit Cloud > Settings > Secrets.
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: change if the default model is retired
GEMINI_MODEL=gemini-2.5-flash
# Optional: photo checks allowed per visitor session
VISION_CALLS_PER_SESSION=12
# Optional: Google Apps Script web app URL that appends feedback to a sheet
FEEDBACK_WEBHOOK_URL=
